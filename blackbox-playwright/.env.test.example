# Salin berkas ini menjadi .env.test lalu sesuaikan nilainya jika perlu.
# Jangan pernah menjalankan suite ini melawan database produksi.

BASE_URL=http://127.0.0.1:8000

ADMIN_EMAIL=admin@werentcar.com
ADMIN_PASSWORD=password

# Harus salah satu akun bawaan seeder (database/seeders/UserSeeder.php) dengan role customer.
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=password

# Path ke file log Laravel, dipakai untuk membaca tautan reset kata sandi
# (MAIL_MAILER=log) pada skenario BB-17. Biarkan default kecuali struktur
# folder proyek berbeda.
LARAVEL_LOG_PATH=../storage/logs/laravel.log
